# --- Database ---
DATABASE_URL=postgresql+psycopg://medirag:medirag@localhost:5432/medirag

# --- Providers: mock | anthropic | gemini | ollama (llm), mock | tesseract (ocr), mock (maps) ---
LLM_PROVIDER=mock
OCR_PROVIDER=mock
MAPS_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required only when LLM_PROVIDER=gemini (1st in the gemini/groq/ollama chain)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2nd in the chain, tried automatically if Gemini fails or produces an
# unsupported/vague answer. Get a free key from https://console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 3rd in the chain, and used directly when LLM_PROVIDER=ollama. No API key
# -- requires a local Ollama install with the model already pulled
# (`ollama pull llama3.1:8b`). A smaller/faster model (e.g. llama3.2:3b) was
# tested and rejected for this role: it fabricated medical content with a
# real-but-unrelated citation attached, which the validator only caught by
# accident. See DECISIONS.md.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Auth ---
AUTH_SECRET=change-me-in-production
AUTH_TOKEN_TTL_MINUTES=60

# --- Storage ---
STORAGE_DIR=./uploads

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DEFAULT_REGION=US
